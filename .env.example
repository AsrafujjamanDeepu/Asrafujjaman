# Create a free access key at https://web3forms.com and paste it here.
# This key is safe to expose in browser code; Web3Forms uses it to route form submissions.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional but recommended: create a free key at https://www.weatherapi.com.
# This stays server-side and powers the live weather card.
WEATHERAPI_KEY=

# Optional: a fine-grained GitHub token raises API rate limits. It stays server-side.
GITHUB_TOKEN=

# Optional: free key from https://api.nasa.gov (1,000 requests/hour) for the
# Astronomy Picture of the Day card. Without it, NASA's shared DEMO_KEY is used,
# which is heavily rate-limited. Stays server-side.
NASA_API_KEY=

# Optional: themed photos on the project cards. Set ONE of these (Unsplash wins
# if both are set). Without either, the cards keep their pastel style.
# Free key: https://unsplash.com/developers (Access Key)
UNSPLASH_ACCESS_KEY=
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=
